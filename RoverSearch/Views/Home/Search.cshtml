@model SearchResults

@{
    ViewData["Title"] = "Search Results";
}

<div class="mt-5 container">
    <div class="mb-4 text-center">
        <div class="row align-items-center">
            <div class="col-2">
                <img src="/images/simpsons-logo.png" class="img-fluid my-3"/>
            </div>
            <div class="col-8">
                Showing results for query: <strong>@Model.Query</strong><br/>
                <small class="text-muted">Search completed in @Model.Duration.TotalMilliseconds ms</small>
            </div>
        </div>
    </div>
    
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="list-group">
                @foreach (var result in Model.Results)
                {
                    <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <h5 class="mb-1" style="color: #f5c518; -webkit-text-stroke: 1px black; font-weight: bold; font-size: 30px;">@result.Title</h5>
                            <small class="text-info fst-italic" style="font-size: 20px;"> Season @result.Season, Episode @result.Episode</small>
                            <p class="mb-0 mt-2 text-dark fst-italic" style="font-size: 15px;">
                                @result.Description
                            </p>
                        </div>
                        <span class="badge bg-primary rounded-pill">View</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>